# =====================================================================
# Sandane Homes — Guest Registration System
# Environment Variables — NEVER commit actual values to git
# =====================================================================

# --- Google Service Account ---
# The full JSON content of your service account key file (as a single line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Google Drive ---
# The ID of the root "Sandane Homes / Guest Registration" Drive folder
GOOGLE_DRIVE_ROOT_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ

# --- Google Sheets ---
# The ID of the "Sandane Homes — Guest Registration" spreadsheet
GOOGLE_SHEET_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_SHEET_NAME=Guest Registrations

# --- Staff Authentication ---
# Staff login credentials (separate with comma for multiple users)
# Format: username:password,username2:password2
STAFF_CREDENTIALS=admin:changeme123

# JWT signing secret (generate a long random string)
JWT_SECRET=replace-with-a-very-long-random-secret-string-here

# --- App Config ---
# Timezone for timestamp recording
HOTEL_TIMEZONE=Asia/Kolkata

# Max ID document file size in bytes (default: 5MB)
MAX_FILE_SIZE_BYTES=5242880

# Frontend URL (for CORS)
FRONTEND_URL=https://www.sandanehomes.com

# --- Rate Limiting ---
# Max registration attempts per IP per 15 minutes
RATE_LIMIT_MAX=10
