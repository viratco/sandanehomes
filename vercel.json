{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/best-serviced-apartments-greater-noida",
            "destination": "/serviced-apartments-greater-noida",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                }
            ]
        },
        {
            "source": "/sitemap-residences.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api|_next|assets|favicon|logo|robots\\.txt|sitemap.*\\.xml|blog/covers|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}
