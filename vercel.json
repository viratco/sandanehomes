{
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [{ "key": "Content-Type", "value": "application/xml" }]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api|_next|assets|favicon|logo|robots\\.txt|sitemap\\.xml|blog/covers|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}